  "info": {
    "_postman_id": "934e8545-c84b-494f-86e0-a44bdc332582",
    "name": "Weglot Translation Languages Translate API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "REST API for the Weglot website translation platform. The /translate endpoint translates an array of sentences from a source language to a target language and is authenticated with an api_key query parameter. The public /public/* endpoints expose the catalog of supported languages, a language-pair support check, and a health-check status endpoint, and require no authentication. This is the same translation service consumed by the Weglot JavaScript, WordPress, Shopify, and CMS integrations.\n\nContact Support:\n Name: Weglot Support",
      "type": "text/plain"
    }
  }
